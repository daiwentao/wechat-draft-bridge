{
  "name": "wechat-draft-bridge",
  "version": "0.3.1",
  "private": true,
  "description": "Preview and send Markdown notes to WeChat Official Account drafts with reusable CSS themes and safe draft updates.",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "security": "node tools/scan-secrets.mjs",
    "verify": "npm run security && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "juice": "^11.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.30",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.5",
    "jsdom": "^26.1.0",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
